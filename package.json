{
  "name": "expediente",
  "version": "1.1.0",
  "private": true,
  "description": "Escritório virtual animado que mostra, em tempo real, o que seus agentes do Claude Code estão fazendo.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude './client/**' server/index.ts --dev",
    "dev:client": "vite --config vite.config.ts",
    "demo": "EXPEDIENTE_DEMO=1 npm run dev",
    "demo:timeline": "tsx scripts/demo-timeline.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "docker:up": "tsx scripts/docker-up.ts",
    "docker:down": "tsx scripts/docker-up.ts --down",
    "docker:logs": "docker compose logs -f expediente",
    "instalar": "tsx scripts/instalar.ts install",
    "instalar:status": "tsx scripts/instalar.ts status",
    "desinstalar": "tsx scripts/instalar.ts uninstall",
    "release": "tsx scripts/release.ts",
    "versao": "tsx scripts/versao.ts",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
