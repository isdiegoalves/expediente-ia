{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expediente.localhost/tema.schema.json",
  "title": "Tema do Expediente",
  "description": "Rascunho (Fase 2). O tema é dado: cores, textos curtos e nomes de arquivo PNG. Nenhum campo aceita URL, HTML, CSS ou código. O mínimo da F1 (B-11) cobre paleta, textos e decoração PNG; móveis, personagens e telas animadas ficam chumbados até o B-29.",
  "type": "object",
  "required": [
    "versao",
    "id",
    "nome",
    "origem",
    "paleta",
    "contraste",
    "textos",
    "decoracao",
    "tipografia"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "versao": {
      "const": 1,
      "$comment": "Sobe quando um campo obrigatório entra; o servidor recusa versão que não conhece e cai no tema padrão."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "nome": {
      "$ref": "#/$defs/texto"
    },
    "origem": {
      "description": "De onde o tema veio. Na F4 (/tema) toda fonte consultada fica registrada aqui.",
      "type": "object",
      "required": [
        "tipo",
        "fontes"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "enum": [
            "padrao",
            "manual",
            "marca"
          ]
        },
        "fontes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "tipo",
              "referencia"
            ],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "enum": [
                  "repositorio",
                  "css",
                  "pagina",
                  "imagem",
                  "kit-de-marca",
                  "manual"
                ]
              },
              "referencia": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^<>{}\\\\`\\u0000-\\u001f]+$"
              },
              "coletadoEm": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    },
    "paleta": {
      "type": "object",
      "required": [
        "ui",
        "status",
        "nivel",
        "marca",
        "salas",
        "nucleo",
        "piso",
        "canvas",
        "mundo"
      ],
      "additionalProperties": false,
      "properties": {
        "ui": {
          "description": "Tokens base da UI em DOM (hoje variáveis --ui-* de client/src/ui/styles.css). Os 342 literais restantes do CSS passam a ser derivados destes por color-mix.",
          "type": "object",
          "required": [
            "fundo",
            "fundoSolido",
            "fundoSuave",
            "fundoHover",
            "linha",
            "linhaForte",
            "texto",
            "textoMudo",
            "textoFraco",
            "destaque",
            "destaqueSuave"
          ],
          "additionalProperties": false,
          "properties": {
            "fundo": {
              "$ref": "#/$defs/cor"
            },
            "fundoSolido": {
              "$ref": "#/$defs/cor"
            },
            "fundoSuave": {
              "$ref": "#/$defs/cor"
            },
            "fundoHover": {
              "$ref": "#/$defs/cor"
            },
            "linha": {
              "$ref": "#/$defs/cor"
            },
            "linhaForte": {
              "$ref": "#/$defs/cor"
            },
            "texto": {
              "$ref": "#/$defs/cor"
            },
            "textoMudo": {
              "$ref": "#/$defs/cor"
            },
            "textoFraco": {
              "$ref": "#/$defs/cor"
            },
            "destaque": {
              "$ref": "#/$defs/cor"
            },
            "destaqueSuave": {
              "$ref": "#/$defs/cor"
            }
          }
        },
        "status": {
          "description": "Cor de cada estado do agente (hoje --st-*).",
          "type": "object",
          "required": [
            "trabalhando",
            "esperando",
            "shell",
            "ocioso",
            "concluido",
            "saindo"
          ],
          "additionalProperties": false,
          "properties": {
            "trabalhando": {
              "$ref": "#/$defs/cor"
            },
            "esperando": {
              "$ref": "#/$defs/cor"
            },
            "shell": {
              "$ref": "#/$defs/cor"
            },
            "ocioso": {
              "$ref": "#/$defs/cor"
            },
            "concluido": {
              "$ref": "#/$defs/cor"
            },
            "saindo": {
              "$ref": "#/$defs/cor"
            }
          }
        },
        "nivel": {
          "description": "Medidores de uso (hoje --lv-*).",
          "type": "object",
          "required": [
            "ok",
            "atencao",
            "critico"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "$ref": "#/$defs/cor"
            },
            "atencao": {
              "$ref": "#/$defs/cor"
            },
            "critico": {
              "$ref": "#/$defs/cor"
            }
          }
        },
        "marca": {
          "description": "Cores do letreiro e do símbolo desenhados em pixel na UI (hoje literais em client/src/ui/icons.ts).",
          "type": "object",
          "required": [
            "letreiro",
            "simbolo",
            "estrela"
          ],
          "additionalProperties": false,
          "properties": {
            "letreiro": {
              "$ref": "#/$defs/rampa",
              "$comment": "sombra, texto, destaque"
            },
            "simbolo": {
              "$ref": "#/$defs/rampa"
            },
            "estrela": {
              "$ref": "#/$defs/cor"
            }
          }
        },
        "salas": {
          "description": "Paletas das salas de projeto (hoje THEMES em client/src/art/theme.ts), escolhidas pela semente da sala.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/sala"
          }
        },
        "nucleo": {
          "description": "Paredes da recepção, banheiros, copa e lounge (hoje CORE_WALLS em client/src/world/layout/core.ts).",
          "type": "object",
          "required": [
            "recepcao",
            "banheiros",
            "copa",
            "copaRevestimento",
            "lounge",
            "vidro"
          ],
          "additionalProperties": false,
          "properties": {
            "recepcao": {
              "$ref": "#/$defs/parede"
            },
            "banheiros": {
              "$ref": "#/$defs/parede"
            },
            "copa": {
              "$ref": "#/$defs/parede"
            },
            "copaRevestimento": {
              "$ref": "#/$defs/parede"
            },
            "lounge": {
              "$ref": "#/$defs/parede"
            },
            "vidro": {
              "$ref": "#/$defs/parede"
            }
          }
        },
        "piso": {
          "description": "Rampas de cor dos 6 tipos de piso que hoje têm literal de cor em client/src/art/surfaces/floor.ts. Concreto, mármore e calçada são calculados sem literal e ficam como estão até o B-29.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "carpete": {
              "$ref": "#/$defs/rampa"
            },
            "xadrez": {
              "$ref": "#/$defs/rampa"
            },
            "azulejo": {
              "$ref": "#/$defs/rampa"
            },
            "grama": {
              "$ref": "#/$defs/rampa"
            },
            "rua": {
              "$ref": "#/$defs/rampa"
            },
            "madeira": {
              "$ref": "#/$defs/rampa"
            }
          },
          "required": [
            "carpete",
            "xadrez",
            "azulejo",
            "grama",
            "rua",
            "madeira"
          ]
        },
        "canvas": {
          "description": "Texto desenhado no canvas: pílulas, rótulos e balões (hoje literais em client/src/world/render/overlay.ts).",
          "type": "object",
          "required": [
            "rotuloFundo",
            "rotuloTexto",
            "rotuloSombra",
            "rotuloContorno",
            "compactoFundo",
            "compactoTexto"
          ],
          "additionalProperties": false,
          "properties": {
            "rotuloFundo": {
              "$ref": "#/$defs/cor"
            },
            "rotuloTexto": {
              "$ref": "#/$defs/cor"
            },
            "rotuloSombra": {
              "$ref": "#/$defs/cor"
            },
            "rotuloContorno": {
              "$ref": "#/$defs/cor"
            },
            "compactoFundo": {
              "$ref": "#/$defs/cor"
            },
            "compactoTexto": {
              "$ref": "#/$defs/cor"
            }
          }
        },
        "mundo": {
          "description": "Fundo externo, anéis de seleção e telhado (hoje literais em client/src/world/render/renderer.ts).",
          "type": "object",
          "required": [
            "fundoExterno",
            "anelSelecao",
            "anelHover",
            "telhado"
          ],
          "additionalProperties": false,
          "properties": {
            "fundoExterno": {
              "$ref": "#/$defs/cor"
            },
            "anelSelecao": {
              "$ref": "#/$defs/cor"
            },
            "anelHover": {
              "$ref": "#/$defs/cor"
            },
            "telhado": {
              "$ref": "#/$defs/rampa"
            }
          }
        }
      }
    },
    "contraste": {
      "description": "Pares que a tela desenha, um item por par de texto ou de elemento de UI. O pré-voo do tema compõe o alpha do fundo sobre a cor opaca de `sobre` e exige `min` (WCAG AA: 4,5 para texto, 3 para indicador). Um tema de marca precisa declarar pelo menos os pares do tema padrão.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "texto",
          "fundo",
          "min"
        ],
        "additionalProperties": false,
        "properties": {
          "texto": {
            "$ref": "#/$defs/caminhoCor"
          },
          "fundo": {
            "$ref": "#/$defs/caminhoCor"
          },
          "sobre": {
            "$ref": "#/$defs/caminhoCor",
            "$comment": "cor opaca sob o fundo; obrigatória quando o fundo tem alpha"
          },
          "min": {
            "enum": [
              4.5,
              3
            ]
          }
        }
      }
    },
    "textos": {
      "description": "Textos trocáveis do mínimo: rótulos de status e nomes das áreas do núcleo. Falas, personalidades e o resto da UI seguem chumbados.",
      "type": "object",
      "required": [
        "produto",
        "status",
        "areasNucleo"
      ],
      "additionalProperties": false,
      "properties": {
        "produto": {
          "$ref": "#/$defs/texto"
        },
        "status": {
          "type": "object",
          "required": [
            "trabalhando",
            "esperando",
            "shell",
            "ocioso",
            "concluido",
            "saindo"
          ],
          "additionalProperties": false,
          "properties": {
            "trabalhando": {
              "$ref": "#/$defs/texto"
            },
            "esperando": {
              "$ref": "#/$defs/texto"
            },
            "shell": {
              "$ref": "#/$defs/texto"
            },
            "ocioso": {
              "$ref": "#/$defs/texto"
            },
            "concluido": {
              "$ref": "#/$defs/texto"
            },
            "saindo": {
              "$ref": "#/$defs/texto"
            }
          }
        },
        "areasNucleo": {
          "type": "object",
          "required": [
            "recepcao",
            "banheiros",
            "copa",
            "lounge"
          ],
          "additionalProperties": false,
          "properties": {
            "recepcao": {
              "$ref": "#/$defs/texto"
            },
            "banheiros": {
              "$ref": "#/$defs/texto"
            },
            "copa": {
              "$ref": "#/$defs/texto"
            },
            "lounge": {
              "$ref": "#/$defs/texto"
            }
          }
        },
        "salas": {
          "description": "Opcional (F4): renomear salas de projeto, que hoje levam o nome da pasta. `pasta` é o nome da pasta como o escritório mostra.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "pasta",
              "nome"
            ],
            "additionalProperties": false,
            "properties": {
              "pasta": {
                "$ref": "#/$defs/texto"
              },
              "nome": {
                "$ref": "#/$defs/texto"
              }
            }
          }
        }
      }
    },
    "tipografia": {
      "description": "Fonte livre empacotada com o tema: arquivo dentro da pasta do tema, licença livre declarada; nenhuma fonte é baixada em tempo de execução. Na F4, `equivalenteDe` registra a fonte proprietária da marca que esta substitui.",
      "type": "object",
      "required": [
        "familia",
        "arquivo",
        "licenca"
      ],
      "additionalProperties": false,
      "properties": {
        "familia": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{0,39}$"
        },
        "arquivo": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*\\.(woff2|woff|ttf)$"
        },
        "licenca": {
          "enum": [
            "OFL-1.1",
            "Apache-2.0",
            "MIT",
            "CC0-1.0"
          ]
        },
        "equivalenteDe": {
          "$ref": "#/$defs/texto"
        }
      }
    },
    "decoracao": {
      "description": "Decoração em PNG, arquivos relativos à pasta do tema. SVG é rasterizado antes de entrar (F4).",
      "type": "object",
      "required": [
        "marca",
        "quadros"
      ],
      "additionalProperties": false,
      "properties": {
        "marca": {
          "type": "object",
          "required": [
            "logo",
            "placa"
          ],
          "additionalProperties": false,
          "properties": {
            "logo": {
              "$ref": "#/$defs/imagem"
            },
            "placa": {
              "$ref": "#/$defs/imagem"
            }
          }
        },
        "quadros": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id",
              "tipo",
              "arquivo"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "tipo": {
                "enum": [
                  "painting",
                  "poster"
                ]
              },
              "arquivo": {
                "$ref": "#/$defs/arquivoPng"
              },
              "tiles": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "moldura": {
                "$ref": "#/$defs/imagem",
                "$comment": "versão emoldurada (framed no manifesto herdado)"
              },
              "variante": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,24}$",
                "$comment": "variant no manifesto herdado"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "rampa": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/cor"
      }
    },
    "texto": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^<>{}\\\\`\\u0000-\\u001f]+$"
    },
    "arquivoPng": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*\\.png$"
    },
    "imagem": {
      "type": "object",
      "required": [
        "arquivo",
        "largura",
        "altura"
      ],
      "additionalProperties": false,
      "properties": {
        "arquivo": {
          "$ref": "#/$defs/arquivoPng"
        },
        "largura": {
          "type": "integer",
          "minimum": 8,
          "maximum": 512
        },
        "altura": {
          "type": "integer",
          "minimum": 8,
          "maximum": 512
        }
      }
    },
    "parede": {
      "type": "object",
      "required": [
        "base",
        "friso",
        "padrao"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/cor"
        },
        "friso": {
          "$ref": "#/$defs/cor"
        },
        "padrao": {
          "enum": [
            "plain",
            "stripes",
            "tiles",
            "wood_panel",
            "brick",
            "glass",
            "marble"
          ]
        }
      }
    },
    "sala": {
      "type": "object",
      "required": [
        "tapete",
        "tapete2",
        "parede",
        "destaque",
        "mesa",
        "cadeira"
      ],
      "additionalProperties": false,
      "properties": {
        "tapete": {
          "$ref": "#/$defs/cor"
        },
        "tapete2": {
          "$ref": "#/$defs/cor"
        },
        "parede": {
          "$ref": "#/$defs/parede"
        },
        "destaque": {
          "$ref": "#/$defs/cor"
        },
        "mesa": {
          "enum": [
            "white",
            "wood",
            "dark"
          ]
        },
        "cadeira": {
          "enum": [
            "black",
            "blue",
            "red",
            "green",
            "gray"
          ]
        }
      }
    },
    "caminhoCor": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^(ui|status|nivel|marca|salas|nucleo|piso|canvas|mundo)(\\.[A-Za-z0-9]+)+$"
    }
  }
}